# 作業フォルダに face.env という名前でコピーして書き換える（説明は README の「作り方」）。
NAME=myface                              # できあがりの名前（作業フォルダ/myface.vrm）
HEAD_GLB=/path/to/head.glb               # 髪なしの頭（髪がなければ、その頭）
# HAIR_GLB=/path/to/head_hair.glb        # 髪つきの頭（同じモデルから書き出したもの）
# BASE=base_asian                        # 体：base_asian（女性）か base_male（男性）
# HEAD_ONLY=1                            # 値を設定すると体と服を外して首から上だけにする（無効にする場合はコメントアウトのまま）
# UP_RAISE=0                             # 上まぶたの線を中央で何 px 上げるか（線の確認で低いと思ったとき）
# HAIR_SPRING=12                         # 髪の揺れる骨の本数。0 で揺らさない
# LIPS=paint                             # keep にすると、唇を元のモデルの色のままにする
# CORNEA=1                               # 0 にすると、目の表面の透過つやを無効にする
# VRM_AUTHOR="your name"                 # VRM に書き込む作者名
