# 作業フォルダに face.env という名前でコピーして書き換える。書かなかったものは既定値（一覧は README の「設定」）。
NAME=myface                              # 出力の名前（<作業フォルダ>/myface.vrm）
HEAD_GLB=/path/to/tripo_head.glb         # Tripo で作った頭（正面向き・口を閉じた顔）の GLB。髪は別の部品なら移植される
# BASE=base_asian                        # 素体：base_asian（女性）か base_male（男性）
# HEAD_ONLY=1                            # 首で切った頭だけにする（体・服・靴を外す）
# HAIR_PART=auto                         # 髪の部品：auto（自動）、none（髪なし）、部品番号
# HAIR_SPRING=12                         # 髪の揺れ：骨の列の数、0 で揺らさない、updo:<セル> でまとめ髪
# VRM_AUTHOR="your name"                 # VRM のメタ情報の作者
# UP_RAISE=0                             # 上まぶたの線を中央で何 px 上げるか（まぶたの線の確認で「少し上」と思ったとき）
# LIPS=paint                             # paint：唇を Tripo の色から塗り直し、つやを足す。keep：Tripo のまま
# LASHES=painted                         # painted：Tripo が描いたまつ毛のまま。3d：まつ毛を立体で生やす
# SLIM_GAIN=0                            # 1.0 で顔の下半分を肖像画の輪郭へ寄せる（Tripo が丸顔になったとき）。使うなら PORTRAIT も
# PORTRAIT=/path/to/portrait.png         # Tripo に入れた元の肖像画（SLIM_GAIN を使うときだけ）
